GATE_API_KEY=your_key
GATE_API_SECRET=your_secret
GATE_API_HOST=https://api.gateio.ws
TRADING_MODE=paper
SYMBOLS=BTC_USDT,GT_USDT,SOL_USDT,ETH_USDT
MAX_POSITION_USDT=200
RISK_LEVEL=high
ENABLE_AUTO_TRADE=false
ENABLE_FUTURES=true
ENABLE_SPOT=true
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
DYNAMIC_POSITION=true
WEIGHT_EMA_ALPHA=0.2
MIN_MODEL_WEIGHT=0.2
PAPER_API_KEY=your_paper_key
PAPER_API_SECRET=your_paper_secret
PAPER_API_HOST=https://fx-api-testnet.gateio.ws
ENABLE_PAPER_TRADE=true
CANDLE_INTERVAL=1m
CANDLE_LIMIT=200
STATE_DIR=src/bot/state
LOG_DIR=src/bot/logs
MAX_RETRIES=3
RETRY_BACKOFF_S=0.5
SAVE_INTERVAL=5
MIN_INTERVAL_MS=500
